[
  {
    "label": "Flutter: run",
    "command": "flutter",
    "args": ["run", "--dart-define-from-file=config/env.json"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Flutter: run (release)",
    "command": "flutter",
    "args": ["run", "--release", "--dart-define-from-file=config/env.json"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Flutter: build apk",
    "command": "flutter",
    "args": ["build", "apk", "--dart-define-from-file=config/env.json"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Flutter: build ios",
    "command": "flutter",
    "args": ["build", "ios", "--no-codesign", "--dart-define-from-file=config/env.json"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  }
]
